# Persistent home-server input. Copy to .env.k3s.local; never commit real values.
K3S_IMAGE_REGISTRY=ghcr.io/christolx
K3S_IMAGE_TAG=sha-0000000000000000000000000000000000000000
K3S_DOMAIN=cartlabs.christofle.dev
GHCR_USERNAME=replace-me
GHCR_PULL_TOKEN=replace-with-read-packages-token

ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes
MOCK_PAYMENT_API_KEY=replace-with-at-least-24-random-bytes
POSTGRES_PASSWORD=replace-me
RABBITMQ_DEFAULT_PASS=replace-me
SEARCH_SERVICE_TOKEN=replace-with-at-least-32-random-bytes
TRUSTED_PROXY_TOKEN=replace-with-at-least-32-random-bytes

CLOUDINARY_CLOUD_NAME=replace-me
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=replace-me
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me

# Opt in only after startup settles and expected traffic is acceptable.
K3S_SYNTHETIC_TRAFFIC=false
