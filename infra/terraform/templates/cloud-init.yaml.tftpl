#cloud-config
package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - jq
  - python3
  - unattended-upgrades
ssh_pwauth: false
disable_root: false
write_files:
  - path: /etc/ssh/sshd_config.d/99-cartlabs.conf
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin prohibit-password
      X11Forwarding no
runcmd:
  - [systemctl, reload, ssh]
  - [systemctl, enable, --now, unattended-upgrades]
