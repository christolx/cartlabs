{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "sum by (route, method) (rate(cartlabs_http_requests_total[5m]))", "legendFormat": "{{method}} {{route}}", "refId": "A" }],
      "title": "API request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, route, method) (rate(cartlabs_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{method}} {{route}}", "refId": "A" }],
      "title": "API p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "targets": [{ "expr": "sum(rate(cartlabs_http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "5xx", "refId": "A" }],
      "title": "API error rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 8 },
      "id": 4,
      "targets": [
        { "expr": "cartlabs_outbox_pending", "legendFormat": "pending", "refId": "A" },
        { "expr": "cartlabs_outbox_dead_letters", "legendFormat": "dead letters", "refId": "B" }
      ],
      "title": "Outbox backlog",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 8 },
      "id": 5,
      "targets": [{ "expr": "sum by (result) (rate(cartlabs_notification_delivery_total[5m]))", "legendFormat": "{{result}}", "refId": "A" }],
      "title": "Notification delivery outcomes",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["cartlabs", "operability"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Cartlabs Overview",
  "uid": "cartlabs-overview",
  "version": 1
}
