{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["global", "images", "ingress", "postgresql", "redis", "rabbitmq"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["imageTag", "domain", "existingSecret"],
      "properties": {
        "imageRegistry": { "type": "string" },
        "imageTag": { "type": "string", "pattern": "^(local|sha-[a-f0-9]{7,40}|v[0-9]+\\.[0-9]+\\.[0-9]+)$" },
        "imagePullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "domain": { "type": "string", "minLength": 1 },
        "existingSecret": { "type": "string", "minLength": 1 }
      }
    },
    "backup": {
      "type": "object",
      "properties": {
        "schedule": { "type": "string", "minLength": 1 },
        "retention": { "type": "string", "pattern": "^[0-9]+[dh]$" }
      }
    },
    "observability": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "traceSampleRatio": { "type": "string", "pattern": "^(0\\.[0-9]*[1-9][0-9]*|1(\\.0+)?)$" },
        "prometheus": {
          "type": "object",
          "properties": {
            "retention": { "type": "string", "pattern": "^[0-9]+[dh]$" },
            "storage": { "type": "string", "minLength": 2 }
          }
        },
        "tempo": {
          "type": "object",
          "properties": {
            "retention": { "type": "string", "pattern": "^[0-9]+[dh]$" },
            "storage": { "type": "string", "minLength": 2 }
          }
        }
      }
    },
    "syntheticTraffic": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "readInterval": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$" },
        "journeyInterval": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$" },
        "requestTimeout": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$" }
      }
    },
    "demoReset": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 1 },
        "suspend": { "type": "boolean" },
        "cloudinarySecret": { "type": "string", "minLength": 1 }
      }
    }
  }
}
